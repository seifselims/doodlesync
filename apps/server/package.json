{
	"name": "server",
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc --noEmit",
		"compile": "bun build --compile --no-compile-autoload-dotenv --minify --sourcemap --bytecode ./src/index.ts --outfile server",
		"dev": "tsx watch src/index.ts",
		"start": "node dist/index.mjs",
		"env:generate": "varlock codegen",
		"auth:generate": "varlock run -- pnpm dlx auth@latest generate --config src/services.ts --output ../../packages/db/src/schema/auth.ts --yes",
		"test": "vitest run",
		"test:domain": "vitest run --project domain",
		"test:transport": "vitest run --project transport",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@doodlesync/auth": "workspace:*",
		"@doodlesync/db": "workspace:*",
		"@doodlesync/shared": "workspace:*",
		"@hono/node-server": "^2.1.1",
		"better-auth": "catalog:",
		"hono": "^4.13.7",
		"varlock": "catalog:",
		"ws": "^8.21.3",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@doodlesync/config": "workspace:*",
		"@types/node": "catalog:",
		"@types/ws": "^8.18.1",
		"tsdown": "^0.23.0",
		"tsx": "^4.23.13",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
